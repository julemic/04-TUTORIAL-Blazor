@page "/songs"
@inject SongListApp.Services.SongService songService
@using SongListApp.Data

<h1>My Song List</h1>
<p>This component demonstrates managing a Song list.</p>

@if (songs == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <button @onclick="Add" class="btn btn-success">Add</button>

    @if (mode == MODE.Add)
    {
        <div class="mt-3">
            <input placeholder="Title" @bind="title" /><br />
            <input placeholder="Artist" @bind="artist" /><br />
            <input placeholder="Year" @bind="year" /><br />
            <button @onclick="Insert" class="btn btn-warning">Insert</button>
        </div>
    }

    <table class="table mt-3">
        <thead>
            <tr><th>ID</th><th>Title</th><th>Artist</th><th>Date</th></tr>
        </thead>
        <tbody>
            @foreach (var item in songs)
            {
                <tr @onclick="@(() => Show(item.Id))" style="cursor:pointer">
                    <td>@item.Id</td>
                    <td>@item.Title</td>
                    <td>@item.Artist</td>
                    <td>@item.Year</td>
                </tr>
            }
        </tbody>
    </table>

    @if (mode == MODE.EditDelete && song != null)
    {
        <div class="mt-3">
            <input type="hidden" @bind="id" />
            <input placeholder="Title" @bind="title" /><br />
            <input placeholder="Artist" @bind="artist" /><br />
            <input placeholder="Year" @bind="year" /><br />
            <button @onclick="Update" class="btn btn-primary">Update</button>
            <button @onclick="Delete" class="btn btn-danger ml-2">Delete</button>
        </div>
    }
}

@code {
    List<Song>? songs;
    string id = string.Empty;
    string title = string.Empty;
    string artist = string.Empty;
    string year = string.Empty;
    Song? song;

    private enum MODE { None, Add, EditDelete }
    MODE mode = MODE.None;

    protected override async Task OnInitializedAsync() => await Load();

    protected async Task Load()
    {
        songs = await songService.GetSongsAsync();
    }

    protected void Add()
    {
        ClearFields();
        mode = MODE.Add;
    }

    protected void ClearFields()
    {
        id = title = artist = year = string.Empty;
        song = null;
    }

    protected async Task Insert()
    {
        Song s = new()
        {
            Id = Guid.NewGuid().ToString(),
            Title = title,
            Artist = artist,
            Year = year
        };
        await songService.InsertSongAsync(s);
        ClearFields();
        await Load();
        mode = MODE.None;
    }

    protected async Task Show(string songId)
    {
        song = await songService.GetSongByIdAsync(songId);
        if (song != null)
        {
            id = song.Id;
            title = song.Title;
            artist = song.Artist;
            year = song.Year;
            mode = MODE.EditDelete;
        }
    }

    protected async Task Update()
    {
        if (string.IsNullOrWhiteSpace(id)) return;
        Song s = new() { Id = id, Title = title, Artist = artist, Year = year };
        await songService.UpdateSongAsync(id, s);
        ClearFields();
        await Load();
        mode = MODE.None;
    }

    protected async Task Delete()
    {
        if (string.IsNullOrWhiteSpace(id)) return;
        await songService.DeleteSongAsync(id);
        ClearFields();
        await Load();
        mode = MODE.None;
    }
}
